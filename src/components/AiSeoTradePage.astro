---
/**
 * The "AI SEO for [trade]" landing page body — one template, 36 trades.
 *
 * Ported from the handoff bundle's templates/trade-template.html. Structure and
 * section order are deliberate and documented: the page is one continuous
 * argument, and the order is the order of that argument (proof before problem,
 * mechanism before comparison, relief after discomfort). Sections can be
 * rewritten freely; reordering one changes what the reader knows when they
 * reach the next. The same goes for the five in-flow CTA positions, the offer
 * fineprint under every CTA, and the keyword span being the first text node
 * inside the H1 — all load-bearing, none of them decoration.
 *
 * Two things were removed on import, both of which existed only to support the
 * pre-publish handoff:
 *   - the build-notes block, which was never part of the page;
 *   - the client-side script that swapped in a placeholder when a screenshot
 *     404'd. Capture availability is now resolved at build time instead, so a
 *     trade still waiting on screenshots renders the placeholder directly.
 *
 * The testimonial slot between the comparison table and pricing is still
 * intentionally empty. It stays empty until there is a real attributable quote.
 *
 * Nav and footer are both the site's own <Header /> and <Footer />, rendered
 * by TradeLanding.astro around this component's content — see that file for
 * why. This component still renders one section of its own after the
 * long-form copy, "AI SEO by trade": Footer already covers Product/Company/
 * Contact, so repeating those here would just be the extra-exit clutter the
 * page design otherwise avoids, but the cross-links between all 36 trades are
 * unique to this page and worth keeping.
 *
 * Everything below is wrapped in `.ai-seo-page`. That wrapper is what lets
 * this component's own `<style is:global>` block below coexist with
 * global.css: both define bare `h1,h2,h3`, `a`, `p`, and — more sharply —
 * both define `.btn`, `.card` and `.eyebrow` with different values (this
 * page's pill buttons and 14px card radius vs. the site's 10px buttons and
 * shadowed cards). Scoping this component's versions under `.ai-seo-page`
 * gives them higher specificity than global.css's bare selectors, so they
 * win inside this page regardless of stylesheet load order, without touching
 * how those same class names render inside <Footer /> — which sits outside
 * `.ai-seo-page` for exactly that reason, so it renders with the site's
 * normal styling, unmodified.
 */
import { links } from '../lib/data.js';
import { tradeLabel, tradePath } from '../lib/trade-fields.js';

interface Props {
  fields: Record<string, string>;
  captures: {
    chat: { file: string; exists: boolean };
    aio: { file: string; exists: boolean };
  };
  /** Every other trade, for the "AI SEO by trade" cross-links. */
  others: { s: string; n: string }[];
}
const { fields: f, captures, others } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (file: string) => `${base}/images/ai-seo-trades/${file}`;
const url = (path: string) => `${base}${path}`;
