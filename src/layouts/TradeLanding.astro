---
/**
 * Shell for the "AI SEO for [trade]" landing pages.
 *
 * Both <Header /> and <Footer /> here are the site's real, shared components —
 * the same ones Base.astro renders everywhere else. Neither was true at
 * first: the handoff's own CLAUDE.md documents a "single navigation element
 * pointing at conversion" rule that the page's original custom nav was built
 * around, and the custom footer existed only because the page arrived as
 * standalone HTML with no shared component to reuse. Both were replaced once
 * it was confirmed the site-wide chrome should win over that page-specific
 * rule. AiSeoTradePage.astro no longer renders any nav or footer of its own.
 *
 * The one thing that rule cost: <Header />'s nav button reads "Sign In",
 * where the page's own custom nav read "Start for $1" linking to #pricing.
 * That $1-trial CTA is still on the page seven more times — hero, pricing
 * cards, sticky mobile bar, etc. — so this only removes it from the one
 * highest-traffic position, the nav itself.
 *
 * global.css is imported for <Header />'s and <Footer />'s sake — both depend
 * on the site's CSS custom properties (--c-navy etc.) and its
 * .container/.btn/.card/.eyebrow utility classes, none of which the trade
 * page defines on its own. Those same class names are also used by the trade
 * page's own content, with different values (different button shape,
 * different card padding), so AiSeoTradePage.astro scopes its own rules under
 * `.ai-seo-page` to keep the two stylesheets from fighting over the same
 * selectors — see the comment on that wrapper there before changing either
 * file.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fonts from '../components/Fonts.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '804361289062226');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=804361289062226&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* /sitemap.xml, not /sitemap-index.xml — this site builds its own XML
        sitemap in src/pages/sitemap.xml.ts rather than using @astrojs/sitemap,
        which is what would have produced an index. Base.astro still points at
        the index form and resolves to nothing. */}
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <Fonts />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script src="../scripts/forms.js"></script>
  </body>
</html>
