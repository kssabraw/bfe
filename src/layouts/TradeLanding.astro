---
/**
 * Shell for the "AI SEO for [trade]" landing pages.
 *
 * These deliberately do NOT use Base.astro's <Header /> — the handoff bundle's
 * CLAUDE.md is explicit about why: the page carries exactly one navigation
 * element pointing at conversion, because every extra nav link raises the odds
 * a visitor leaves before the hero lands. AiSeoTradePage.astro ships its own
 * nav for that reason, and that stays.
 *
 * The footer is a different call, and not the same rule: it sits below the
 * final CTA and long-form section, after every in-flow conversion point, so
 * using the site's own <Footer /> here doesn't reopen an early exit — it's
 * the same swap Base.astro-based pages already make at that point in the
 * page. Using the real component (not a recreation) also means it never
 * drifts from the one every other page ships.
 *
 * global.css is imported for the footer's sake — it depends on the site's
 * CSS custom properties (--c-navy etc.) and its .container/.btn/.card/.eyebrow
 * utility classes, none of which the trade page defines on its own. Those
 * same class names are also used by the trade page's own content above the
 * footer, with different values (different button shape, different card
 * padding), so AiSeoTradePage.astro scopes its own rules under `.ai-seo-page`
 * to keep the two stylesheets from fighting over the same selectors — see the
 * comment on that wrapper there before changing either file.
 */
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '804361289062226');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=804361289062226&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* /sitemap.xml, not /sitemap-index.xml — this site builds its own XML
        sitemap in src/pages/sitemap.xml.ts rather than using @astrojs/sitemap,
        which is what would have produced an index. Base.astro still points at
        the index form and resolves to nothing. */}
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <Footer />
    <script src="../scripts/forms.js"></script>
  </body>
</html>
