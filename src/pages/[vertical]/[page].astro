---
// /<vertical>/ai-tracking-<vertical> — one page per vertical, 36 in total.
import Base from '../../layouts/Base.astro';
import AiTrackingVerticalPage from '../../components/AiTrackingVerticalPage.astro';
import { verticals } from '../../data/verticals/index.js';
import { aiTrackingVerticalTitle, aiTrackingVerticalSlug } from '../../lib/ai-tracking-verticals';

export function getStaticPaths() {
  return verticals.map((v) => ({
    params: { vertical: v.slug, page: aiTrackingVerticalSlug(v.slug) },
    props: { data: v },
  }));
}

const { data } = Astro.props;
---

<Base title={aiTrackingVerticalTitle(data.name)} description={data.subhead}>
  <AiTrackingVerticalPage data={data} />
</Base>
