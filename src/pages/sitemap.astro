---
// Human-readable sitemap. The XML sitemap for crawlers is generated by
// @astrojs/sitemap (/sitemap-index.xml) — this page is the browsable version,
// and it stays in sync automatically because every group is derived from the
// same sources the routes are (the blog collection, the verticals data, and
// the page registry in src/lib/site-pages).
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { verticals } from '../data/verticals/index.js';
import { aiTrackingPath, verticalPath } from '../lib/verticals';
import { sortPosts } from '../lib/blog';
import { SITEMAP_GROUPS, assertSitemapCoverage, staticPages } from '../lib/site-pages';

// Every page file in the project, resolved at build time — routes under
// src/pages, plus any hand-written HTML in public, which is copied through
// without a route and so appears in no other index. Nothing is imported, only
// the keys are used, so this costs a directory walk and no page code. Vite
// leaves the globbing module out of its own results, so this file is added
// back by hand. If a page isn't accounted for in the registry, the build fails.
assertSitemapCoverage([
  ...Object.keys(import.meta.glob('/src/pages/**/*.{astro,md,mdx,html}')),
  ...Object.keys(import.meta.glob('/public/**/*.{html,htm}')),
  '/src/pages/sitemap.astro',
]);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;

const posts = sortPosts(await getCollection('blog'));
const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const groups = SITEMAP_GROUPS.map((heading) => ({
  heading,
  links: staticPages
    .filter((page) => page.group === heading)
    .map((page) => ({ label: page.label, href: url(page.route) })),
})).filter((group) => group.links.length > 0);

const industries = [...verticals].sort((a, b) => a.name.localeCompare(b.name));
---

<Base
  title="Sitemap – Be Found Everywhere"
  description="Every page on the Be Found Everywhere site — apps, pricing, AI tracking pages by industry, and the full blog archive."
>
  <section class="section section--light">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Sitemap</span>
        <h1>Everything on this site</h1>
        <p>A full index of our pages — apps, industry AI tracking pages, and every blog post.</p>
      </div>

      <div class="sitemap-grid">
        {groups.map((group) => (
          <section class="card sitemap-card">
            <h2>{group.heading}</h2>
            <ul class="sitemap-list">
              {group.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <!-- One entry per vertical silo: the vertical page on top, the topic
           pages that belong to it indented beneath. The silo's blog posts are
           not repeated here — they are all listed in "Blog posts" below. -->
      <section class="sitemap-block">
        <h2>Industries</h2>
        <p class="sitemap-block-note">{industries.length} industry silos.</p>
        <ul class="sitemap-list sitemap-list--silos">
          {industries.map((v) => (
            <li>
              <a href={`${url(verticalPath(v.slug))}/`}>AI SEO for {v.name}</a>
              <ul class="sitemap-list">
                <li><a href={`${url(aiTrackingPath(v.slug))}/`}>AI Tracking for {v.name}</a></li>
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <section class="sitemap-block">
        <h2>Blog posts</h2>
        <p class="sitemap-block-note">{posts.length} posts, newest first.</p>
        <ul class="sitemap-list sitemap-list--posts">
          {posts.map((post) => (
            <li>
              <a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
              <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</Base>

<style>
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 56px;
  }
  .sitemap-card h2 {
    font-size: 1.15rem;
    margin-bottom: 16px;
  }
  .sitemap-block {
    margin-top: 48px;
  }
  .sitemap-block h2 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .sitemap-block-note {
    color: var(--c-muted);
    font-size: 14px;
    margin-bottom: 22px;
  }
  .sitemap-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sitemap-list li {
    margin-bottom: 10px;
    font-size: 15px;
  }
  .sitemap-list--columns {
    columns: 3;
    column-gap: 32px;
  }
  .sitemap-list--columns li {
    break-inside: avoid;
  }
  .sitemap-list--silos {
    columns: 2;
    column-gap: 40px;
  }
  .sitemap-list--silos > li {
    break-inside: avoid;
    margin-bottom: 20px;
    font-weight: 600;
  }
  .sitemap-list--silos > li > ul {
    margin-top: 6px;
    padding-left: 16px;
    border-left: 2px solid var(--c-border);
  }
  .sitemap-list--silos > li > ul li {
    font-weight: 400;
    margin-bottom: 6px;
  }
  .sitemap-list--posts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1px solid var(--c-border);
    margin-bottom: 0;
  }
  .sitemap-list--posts time {
    color: var(--c-muted);
    font-size: 13px;
    white-space: nowrap;
  }
  @media (max-width: 1100px) {
    .sitemap-grid { grid-template-columns: repeat(2, 1fr); }
    .sitemap-list--columns { columns: 2; }
  }
  @media (max-width: 640px) {
    .sitemap-grid { grid-template-columns: 1fr; }
    .sitemap-list--columns { columns: 1; }
    .sitemap-list--silos { columns: 1; }
    .sitemap-list--posts li {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
